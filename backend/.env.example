# انسخ الملف ده لـ .env وعدّل القيم

ENVIRONMENT=production
DEBUG=false

# قاعدة البيانات على سيرفر Hetzner
DATABASE_URL=postgresql+psycopg://students:CHANGE_ME@localhost:5432/students_helper

# Firebase لتسجيل الدخول فقط
FIREBASE_PROJECT_ID=your-firebase-project-id

# تخزين ملفات الكتب (nginx بيخدمها من المسار ده)
MEDIA_ROOT=/var/www/students-helper/media
MEDIA_URL_PREFIX=/media
MAX_UPLOAD_MB=200

# لوحة التحكم — ولّد الهاش بالأمر:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('كلمة-السر'))"
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

CORS_ORIGINS=*
